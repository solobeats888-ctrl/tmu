<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TMU - Sound Font Player</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="TMU VST3" description="Para FL Studio y la mayoría de los DAW.">
        <pkg-ref id="com.viszeversa.tmu.vst3"/>
    </choice>
    <choice id="au" title="TMU Audio Unit" description="Para Logic, GarageBand y otros DAW que usan AU.">
        <pkg-ref id="com.viszeversa.tmu.au"/>
    </choice>
    <pkg-ref id="com.viszeversa.tmu.vst3" version="1.0.0" onConclusion="none">TMU-VST3.pkg</pkg-ref>
    <pkg-ref id="com.viszeversa.tmu.au" version="1.0.0" onConclusion="none">TMU-AU.pkg</pkg-ref>
</installer-gui-script>
