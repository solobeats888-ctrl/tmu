#!/bin/bash
# Quita la cuarentena y hace que macOS vuelva a leer los Audio Units.
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/TMU.vst3" 2>/dev/null
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/Components/TMU.component" 2>/dev/null
killall -9 AudioComponentRegistrar 2>/dev/null
exit 0
